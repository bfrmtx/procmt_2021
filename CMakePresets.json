{
  "version": 8,
  "configurePresets": [
    {
      "name": "procmt",
      "displayName": "procmt (Clang Debug)",
      "description": "Using compilers: C = /usr/bin/clang, CXX = /usr/bin/clang++",
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/build/procmt_2021/build",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "/usr/local/procmt",
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "procmt",
      "configurePreset": "procmt",
      "jobs": 0
    }
  ]
}